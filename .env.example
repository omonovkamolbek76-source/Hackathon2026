# ============================================================
# TadbirkorAI — environment
# ============================================================

# --- Database ---
# Local (default):
DATABASE_URL="file:./dev.db"
# Postgres (docker-compose):
# DATABASE_URL="postgresql://tadbirkor:tadbirkor@localhost:5432/tadbirkorai?schema=public"

# --- Auth (min 32 chars) ---
AUTH_SECRET="replace-with-long-random-secret-at-least-32-chars"

# --- App ---
NEXT_PUBLIC_APP_NAME=TadbirkorAI
APP_URL=http://localhost:3000

# --- AI Coach (REQUIRED for LLM; without it local coach is used) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Monitoring (optional) ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Payments / subscription (optional Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Backup ---
BACKUP_DIR=./backups
