# BusinessOS AI
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# SQLite for local/MVP. Production: postgresql://user:pass@host:5432/businessos
DATABASE_URL="file:./packages/database/dev.db"

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Optional LLM. If empty, orchestrator uses deterministic intent + real tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Seed admin
SEED_ADMIN_EMAIL=admin@businessos.uz
SEED_ADMIN_PASSWORD=ChangeMeAdmin1!
SEED_DEMO_EMAIL=tadbirkor@businessos.uz
SEED_DEMO_PASSWORD=Demo1234!
