{
  "name": "@businessos/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --name init",
    "push": "prisma db push",
    "seed": "tsx src/seed.ts",
    "verify": "tsx src/verify-mvp.ts",
    "reset": "prisma db push --force-reset && tsx src/seed.ts",
    "build": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@businessos/shared": "workspace:*",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
