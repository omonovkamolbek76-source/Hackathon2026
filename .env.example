# ============================================================
# TadbirkorAI — .env (shu faylni nusxa qiling: cp .env.example .env)
# Qiymatlarni O'ZINGIZ qo'lda yozing. .env Git'ga kirmaydi.
# ============================================================

# --- Database (majburiy) ---
# Lokal SQLite (default, hech narsa o'rnatmasdan ishlaydi):
DATABASE_URL="file:./dev.db"
# Postgres (ixtiyoriy): docker compose up -d dan keyin:
# DATABASE_URL="postgresql://tadbirkor:tadbirkor@localhost:5432/tadbirkorai?schema=public"

# --- Auth (majburiy, kamida 32 belgi) ---
# O'zingiz random yozing yoki: openssl rand -base64 48
AUTH_SECRET="bu-yerga-uzun-random-secret-yozing-kamida-32-belgi"

# --- App ---
NEXT_PUBLIC_APP_NAME=TadbirkorAI
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
BACKUP_DIR=./backups

# --- Google / Microsoft orqali kirish (ixtiyoriy) ---
# Bo'sh qoldirsangiz "Continue with Google/Microsoft" tugmalari 501 qaytaradi,
# lekin email+parol orqali kirish/ro'yxatdan o'tish odatdagidek ishlayveradi.
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: https://portal.azure.com -> App registrations
#   Redirect URI (Web): {APP_URL}/api/auth/microsoft/callback
#   Supported account types: shaxsiy va tashkilot hisoblari (tenant=common)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Ixtiyoriy: faqat bitta tashkilotga cheklash uchun aniq tenant GUID kiriting.
# Bo'sh bo'lsa "common" ishlatiladi (shaxsiy + tashkilot hisoblari).
MICROSOFT_TENANT_ID=

# --- AI Coach (ixtiyoriy) ---
# Bo'sh qoldirsangiz lokal murabbiy ishlaydi.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Monitoring (ixtiyoriy) ---
# Sentry: https://sentry.io → Project → Client Keys (DSN)
SENTRY_DSN=

# --- Payments (ixtiyoriy) ---
# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
