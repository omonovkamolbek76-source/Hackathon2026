generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable: OAuth-only accounts (Google/Microsoft) never get a local password.
  passwordHash String?
  name         String
  phone        String   @default("")
  businessName String   @default("")
  region       String   @default("")
  role         String   @default("user") // user | admin — never set from client/OAuth input
  image        String   @default("") // avatar URL, populated from OAuth profile picture if present
  emailVerified Boolean @default(false)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String   @default("")
  mfaTempSecret String  @default("")
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks           Task[]
  transactions    Transaction[]
  chatMessages    ChatMessage[]
  businessPlans   BusinessPlan[]
  creditApps      CreditApplication[]
  allocations     FundAllocation[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  payments        Payment[]
  bankConnections BankConnection[]
  oauthAccounts   OAuthAccount[]
  businessProfile BusinessProfile?
  subscriptions   Subscription[]
  aiUsageDaily    AiUsageDaily[]
  telegramConnection    TelegramConnection?
  telegramLinkTokens    TelegramLinkToken[]
  notificationSettings  NotificationSettings?
  telegramNotifications TelegramNotification[]
}

// One row per linked external identity provider account. `provider` +
// `providerAccountId` (the provider's stable subject/user id, NOT email) is
// the unique key — this is what lets the same Google/Microsoft identity log
// back in and be recognized, without ever trusting email equality alone for
// account linking.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // google | microsoft
  providerAccountId String // OIDC `sub` claim from the provider
  email             String   @default("") // provider-reported email at link time, for reference only
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Task {
  id        String   @id @default(cuid())
  userId    String
  title     String
  subtitle  String   @default("")
  category  String   @default("planning")
  status    String   @default("today")
  dueDate   String   @default("")
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  title      String
  amount     Int
  type       String // income | expense
  category   String   @default("other")
  source     String   @default("manual") // manual | csv | bank
  externalId String   @default("")
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, externalId])
}

model ChatMessage {
  id           String   @id @default(cuid())
  userId       String
  role         String
  content      String
  stage        Int?
  stageName    String?
  quickReplies String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BusinessPlan {
  id                String   @id @default(cuid())
  userId            String
  businessName      String
  targetAudience    String
  budget            Int
  description       String
  concept           String
  marketOpportunity String
  competitors       String
  marketingPlan     String
  operationalPlan   String
  financialPlan     String
  expenses          String
  expectedRevenue   String
  breakeven         String
  nextSteps         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditProduct {
  id             String   @id @default(cuid())
  name           String
  bank           String
  amountMin      Int
  amountMax      Int
  interestRate   Float
  termMonths     Int
  gracePeriod    Int      @default(0)
  collateral     String
  purposeTags    String
  active         Boolean  @default(true)
  sourceNote     String   @default("Verify on official bank / oilakredit.uz")
  sourceUrl      String   @default("https://oilakredit.uz")
  lastVerifiedAt DateTime @default(now())
  createdAt      DateTime @default(now())
}

model CreditApplication {
  id        String   @id @default(cuid())
  userId    String
  answers   String
  results   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FundAllocation {
  id        String   @id @default(cuid())
  userId    String
  category  String
  label     String
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, category])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  meta      String   @default("{}")
  ip        String   @default("")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  kind      String   @default("info") // info | tax | payment | security
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  provider    String   @default("local") // local | stripe
  amount      Int
  currency    String   @default("UZS")
  purpose     String   @default("subscription")
  status      String   @default("pending") // pending | paid | failed | canceled
  externalId  String   @default("")
  checkoutUrl String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Per-user business context. Only aggregated/summarized fields from this
// model are ever sent to Gemini (least-data principle) — see
// lib/ai-copilot/context-builder.ts. Array-valued fields are stored as JSON
// strings (consistent with ChatMessage.quickReplies elsewhere in this schema).
model BusinessProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  businessName      String   @default("")
  idea              String   @default("")
  industry          String   @default("")
  location          String   @default("")
  targetCustomer    String   @default("")
  product           String   @default("")
  service           String   @default("")
  budget            Int      @default(0)
  suppliers         String   @default("[]")
  salesChannels     String   @default("[]")
  marketingChannels String   @default("[]")
  stage             String   @default("IDEA") // IDEA | VALIDATION | STARTING | EARLY_SALES | GROWING | ESTABLISHED
  goals             String   @default("[]")
  challenges        String   @default("[]")
  surveyAnswers     String   @default("{}")
  surveyStep        Int      @default(0)
  surveyDone        Boolean  @default(false)
  surveyDismissed   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Subscription tiers — prices/features/limits are DATA, never hardcoded in
// route/component code. Seeded with starter values (prisma/seed.ts); meant to
// be adjusted later through an admin-only API without a code deploy.
model SubscriptionPlan {
  id                 String   @id @default(cuid())
  key                String   @unique // FREE | BUSINESS | BUSINESS_PRO | FINANCIAL | FINANCIAL_PRO
  name               String
  priceCents         Int      @default(0) // smallest currency unit (e.g. USD cents)
  currency           String   @default("USD")
  interval           String   @default("month")
  features           String   @default("[]") // JSON array of display strings
  aiMessagesPerDay   Int      @default(10)
  voiceMinutesPerDay Int      @default(0)
  financialAnalysis  Boolean  @default(false)
  prioritySupport    Boolean  @default(false)
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  planId             String
  status             String   @default("active") // active | trialing | past_due | cancelled | expired
  provider           String   @default("local") // local | stripe
  providerRef        String   @default("") // Payment.id or Stripe subscription id
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

// Daily AI usage counters — backend-enforced quota per plan (never a
// frontend-only limit). One row per user per calendar day (UTC date string).
model AiUsageDaily {
  id           String   @id @default(cuid())
  userId       String
  day          String // YYYY-MM-DD (UTC)
  messages     Int      @default(0)
  voiceSeconds Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// ============================================================
// Telegram push notification system — PLATFORM DATA ONLY.
// No AI, no external data. See lib/telegram/*.
// ============================================================

// One row per user who has linked a Telegram account. `telegramChatId` is
// the Telegram chat id used to send messages via the Bot API.
model TelegramConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  telegramChatId String   @unique
  status         String   @default("active") // active | blocked | unlinked
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Short-lived, single-use token used to securely link a Telegram chat to a
// platform user (Telegram deep-link `/start <token>`). Never reusable, never
// guessable, and expires quickly — see lib/telegram/link.ts.
model TelegramLinkToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Per-user opt-in/opt-out toggles. Defaults to all-enabled; a user who
// disables a category never receives that category's notifications.
model NotificationSettings {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  telegramEnabled           Boolean  @default(true)
  taskNotifications         Boolean  @default(true)
  financialNotifications    Boolean  @default(true)
  businessNotifications     Boolean  @default(true)
  subscriptionNotifications Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per Telegram push attempt. `eventId` is derived from the SOURCE
// platform record (e.g. a Task or Transaction id) — the unique constraint on
// (userId, type, eventId) is what makes the checker idempotent and safe to
// run from multiple server instances (see lib/telegram/checker.ts).
model TelegramNotification {
  id             String    @id @default(cuid())
  userId         String
  telegramChatId String
  type           String // TASK_REMINDER | DEADLINE_REMINDER | FINANCIAL_UPDATE | BUSINESS_UPDATE | APPLICATION_UPDATE | SUBSCRIPTION_UPDATE | SYSTEM_NOTIFICATION
  eventId        String // idempotency key, scoped to the source platform record
  title          String
  message        String
  status         String    @default("pending") // pending | sent | failed | blocked
  attempts       Int       @default(0)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, eventId])
  @@index([userId, status])
  @@index([status, createdAt])
}

model BankConnection {
  id           String   @id @default(cuid())
  userId       String
  provider     String   @default("csv") // csv | uzcard_stub | humo_stub
  status       String   @default("active") // active | revoked
  label        String   @default("Bank ko‘chirma")
  // NEVER store PAN/CVV/OTP — only opaque connection metadata
  tokenHint    String   @default("")
  lastImportAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
